# Git LFS keeps the capture set, the truth volumes and the compiled kernel out
# of the normal object store: they are megabytes of pixels and floats that no
# reviewer needs to diff. Everything else stays plain git.
* text=auto

*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.f32 filter=lfs diff=lfs merge=lfs -text
*.f32.gz filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
*.wat text
